[Unit]
Description=mano broker request-only socket
Wants=mano-broker-control.socket mano-broker-provision.socket
After=mano-broker-control.socket mano-broker-provision.socket

[Socket]
ListenSequentialPacket=/run/mano-broker/request.sock
SocketUser=root
SocketGroup=mano-request
SocketMode=0660
DirectoryMode=0755
PassCredentials=yes
FileDescriptorName=request
Backlog=32
RemoveOnStop=yes

[Install]
WantedBy=sockets.target

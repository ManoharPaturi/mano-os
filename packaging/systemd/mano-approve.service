[Unit]
Description=mano native PAM approval adapter
Requires=mano-approve.socket mano-broker-control.socket
After=mano-approve.socket mano-broker-control.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
Sockets=mano-approve.socket
ExecStart=/usr/libexec/mano-approve
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=1
WatchdogSec=20
TimeoutStartSec=10
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=16
MemoryMax=64M
CPUQuota=20%
LimitNOFILE=128
LimitCORE=0

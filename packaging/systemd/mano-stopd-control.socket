[Unit]
Description=mano protected native rearm control

[Socket]
ListenSequentialPacket=/run/mano-stopd/control.sock
Service=mano-stopd.service
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
PassCredentials=yes
FileDescriptorName=control
Backlog=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target

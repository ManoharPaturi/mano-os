[Unit]
Description=mano opaque fixed provider egress
Requires=mano-core.slice
After=mano-core.slice

[Service]
Type=exec
User=mano-egress
Group=mano-egress
Slice=mano-core.slice
ExecStart=/usr/bin/python3 -m mano_egress.service
StandardInput=socket
StandardOutput=null
StandardError=journal
Environment=PYTHONPATH=/usr/lib/mano-os
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=config:/etc/mano/egress.json
UMask=0077
RuntimeMaxSec=35
TimeoutStopSec=1
KillMode=control-group
KillSignal=SIGKILL
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/etc/mano/credentials -/var/lib/mano-broker -/run/mano-broker -/run/mano-provider
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=64M
TasksMax=4
CPUQuota=20%
LimitNOFILE=32
LimitCORE=0

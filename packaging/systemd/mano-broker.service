[Unit]
Description=mano non-root request broker
Requires=mano-broker.socket
After=mano-broker.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
User=mano-broker
Group=mano-broker
ExecStart=/usr/bin/python3 -m mano_broker.service
Environment=PYTHONPATH=/usr/lib/mano-os
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=mano-broker/runtime
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1
WatchdogSec=6
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=16
MemoryMax=128M
CPUQuota=20%
LimitNOFILE=128

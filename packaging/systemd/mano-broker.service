[Unit]
Description=mano non-root request broker
Requires=mano-broker.socket mano-broker-control.socket mano-broker-provision.socket mano-stopd.service
After=mano-broker.socket mano-broker-control.socket mano-broker-provision.socket mano-stopd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
Sockets=mano-broker.socket mano-broker-control.socket mano-broker-provision.socket
User=mano-broker
Group=mano-broker
ExecStart=/usr/bin/python3 -m mano_broker.service
Environment=PYTHONPATH=/usr/lib/mano-os
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=pricing:/etc/mano/pricing.json
StateDirectory=mano-broker/runtime
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1
WatchdogSec=6
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# systemd v257's RestrictSUIDSGID blocks openat2 with ENOSYS. Broker opens
# targets only with fixed O_PATH flags; forbid identity/owner/mode mutation,
# retaining NNP/capability-zero and the rest of the service syscall filter.
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service openat2
SystemCallFilter=~@setuid @chown chmod fchmod fchmodat fchmodat2
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=16
MemoryMax=128M
CPUQuota=20%
LimitNOFILE=128

[Unit]
Description=mano native independent emergency Stop
Requires=mano-stopd.socket mano-stopd-control.socket mano-core.slice
After=mano-stopd.socket mano-stopd-control.socket mano-core.slice

[Service]
Type=notify
Sockets=mano-stopd.socket mano-stopd-control.socket
ExecStart=/usr/libexec/mano-stopd
User=root
Group=root
UMask=0022
StateDirectory=mano-stopd
StateDirectoryMode=0755
Restart=on-failure
RestartSec=1
WatchdogSec=6
TimeoutStartSec=10
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=no
ReadWritePaths=-/sys/fs/cgroup/system.slice/mano-launcher.service /sys/fs/cgroup/mano.slice/mano-core.slice
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=4
MemoryMax=32M
CPUQuota=10%
LimitNOFILE=32
LimitCORE=0

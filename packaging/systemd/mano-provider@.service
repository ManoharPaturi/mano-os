[Unit]
Description=mano isolated credentialed provider job
Requires=mano-core.slice mano-egress.socket
After=mano-core.slice mano-egress.socket

[Service]
Type=exec
User=mano-provider
Group=mano-provider
Slice=mano-core.slice
ExecStart=/usr/bin/python3 -m mano_provider.service
StandardInput=socket
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/usr/lib/mano-os
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=config:/etc/mano/provider.json
LoadCredential=api-key:/etc/mano/credentials/openai
UMask=0077
RuntimeMaxSec=35
TimeoutStopSec=1
KillMode=control-group
# Provider effects are journaled before dispatch; no Python shutdown cooperation.
KillSignal=SIGKILL
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=8
MemoryMax=128M
CPUQuota=20%
LimitNOFILE=32
LimitCORE=0
